# Copy this file to `.env` and fill in the keys for the providers you want to use.
# You only need ONE LLM provider and ONE TTS provider configured.
#
# IMPORTANT: put your real keys in `.env` (gitignored), never in this file.

# --- LLM provider selection ---
# "openai" | "anthropic" | "auto" (auto picks whichever key below is set)
LLM_PROVIDER=auto

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- TTS provider selection ---
# "elevenlabs" | "cartesia" | "auto" (auto picks whichever key below is set)
TTS_PROVIDER=auto

ELEVENLABS_API_KEY=
# Ideally a voice CLONED from the user's own voice, so InnerVoice whispers
# back in "their own voice" per the product spec.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_turbo_v2_5

CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-2

# --- Behavior tuning ---
MIN_CONTINUATION_WORDS=4
MAX_CONTINUATION_WORDS=15
MIN_CONTEXT_CHARS=6

# --- Research knobs (see docs/research-roadmap.md) ---
# Scales the target whisper length with how many words the user has typed
# (target_words ~= input_word_count * this ratio, clamped to the min/max
# above). Set to 0 to always target MAX_CONTINUATION_WORDS (old behavior).
DURATION_WORDS_PER_INPUT_WORD=0.6
# Whether the predicted text is ever shown on screen as a caption.
SHOW_CAPTION=true
# Whether recent whispers are fed back in as prior context (a growing
# "innervoice conversation" memory) instead of each request being stateless.
ENABLE_WHISPER_MEMORY=false
WHISPER_MEMORY_TURNS=3
# "Echo Mode": reveal the predicted text word-by-word in sync with the
# whisper's audio (instead of showing it instantly), then keep it on
# screen instead of fading, so it can be reread -- see roadmap #10.
# ECHO_REVEAL_WPM is only an assumed speaking rate used to pace the
# reveal estimate, not an exact per-word timestamp sync.
ENABLE_ECHO_REVEAL=false
ECHO_REVEAL_WPM=165

# --- Server ---
# Comma-separated list of allowed origins, or "*" for local dev.
CORS_ORIGINS=*
